# SettleUp Backend — Environment Variables
# Copy this file to .env and fill in values before running locally.

# Database
DB_URL=jdbc:postgresql://localhost:5432/settleup
DB_USERNAME=settleup
DB_PASSWORD=settleup_secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — CHANGE THIS to a long random secret in production!
JWT_SECRET=ThisIsAVeryLongSecretKeyForJWTSigningAndShouldBeAtLeast256BitsLong!
JWT_EXPIRATION_MS=86400000

# Server
SERVER_PORT=8080
JPA_DDL_AUTO=update
